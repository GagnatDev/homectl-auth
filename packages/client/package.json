{
  "name": "@gagnatdev/homectl-auth-client",
  "version": "0.2.0",
  "description": "Client package for homectl-auth — server-side Express middleware and browser-side token helper",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "express": "^4.x"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "jose": "^6.2.12",
    "jwks-rsa": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.2",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
